NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret des tâches planifiées Vercel (vercel.json → crons).
# Vercel envoie automatiquement « Authorization: Bearer <CRON_SECRET> » dès que
# cette variable existe dans le projet. Si elle est absente, toutes les routes
# d'automatisation refusent (échec fermé) — voir lib/api/require-automation.ts.
CRON_SECRET=

# Secret des appels pg_cron Supabase (migration 167, en-tête x-automation-secret).
AUTOMATION_SECRET=

# Garde-fou production des scripts scripts/seed-*.ts (ticket R006-SEED-SCRIPT-NO-GUARD).
# Obligatoire pour exécuter scripts/seed-demo-data.ts. Valeurs autorisées uniquement :
# development | local | recette | test — toute autre valeur (y compris absente ou
# "production") est refusée par défaut. Voir scripts/lib/seed-production-guard.ts —
# cette variable ne désactive rien : le script refuse quand même si
# NEXT_PUBLIC_SUPABASE_URL pointe vers le projet de production connu, ou si
# VERCEL_ENV/NODE_ENV valent "production".
SEED_TARGET_ENV=
